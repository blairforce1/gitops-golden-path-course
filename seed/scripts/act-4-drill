#!/usr/bin/env bash
# Act IV drill runner: the fleet from nothing, unattended, with the number from artifacts.
#
# DESTRUCTIVE - it deletes and rebuilds all three kind clusters. Guarded by --yes. "Nothing"
# here is every kind cluster; what survives is git, the three root keys under
# ~/.config/gitops-golden-path/age/, and one flag: --write on the platform cluster's sync, the
# robot's privilege (stage 14). Its key does not survive - cluster-sync mints a new read-write
# one and registers it in the old one's place. Everything else the act built comes back from
# git unasked: the two image controllers, the image objects, the Receiver and its token, the
# digest pins and their policy. The hub's metric history dies with the platform node (the
# store is pod-local), so a promotion straight after waits for traffic. Drills 2 to 4 are PRs,
# a robot, an event and queries: the checkpoint runs them by hand and the promote and
# audit-evidence skills run them on request; this script is the rebuild they all start from.
# Same as act-3-drill with --write on local-01, the sweep on the checkpoints the act's stages
# gate on (06 on the platform cluster, 07 fleet-wide), the image objects and the Receiver
# waited Ready, and the key asserted read-write. Timings are extracted from artifacts
# (namespace creation stamps, the stamps' own reconcile history) - no stopwatch, same rule as
# act-checkpoint.md.
#
# Usage:
#   act-4-drill
#   act-4-drill --yes
#
# Options:
#   --yes       run it; bare, the script prints what it would destroy and exits 1
#   -h, --help  this text
#
# Examples:
#   # read the blast radius, nothing is touched
#   ./scripts/act-4-drill
#   # the run; the log is /tmp/act-4-drill.log
#   ./scripts/act-4-drill --yes
#
# See also: the Act IV checkpoint page; run-drill (the skill that runs this and writes the pack); checkpoint-07
set -euo pipefail
case "${1-}" in -h|--help) sed -n '2,/^\([^#]\|$\)/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0;; esac

cd "$(dirname "$0")/.."

if [ "${1:-}" != "--yes" ]; then
  cat <<EOF
act-4-drill rebuilds the Act IV fleet from nothing. It will:
  1. DELETE the three kind clusters ggp-local-01, ggp-dev-01 and ggp-prod-01
  2. recreate them (cluster-up) and bootstrap each from git (cluster-sync), the platform
     cluster with --write: a new READ-WRITE deploy key replaces the robot's old one
  3. pay the surviving IOU: one root key per cluster, from ~/.config/gitops-golden-path/age/
  4. wait for the fleet to converge, image controllers and Receiver included, run
     checkpoint-06 on the platform cluster and checkpoint-07 across the fleet, and print
     fleet-from-nothing, measured from artifacts
Nothing is simulated. Run with --yes to proceed.
EOF
  exit 1
fi

# --- preflight: fail before any damage ---------------------------------------
for t in flux gh git jq kind kubectl kustomize; do
  command -v "$t" >/dev/null || { echo "MISSING: $t" >&2; exit 1; }
done
[ -n "$(gh auth token 2>/dev/null)" ] || { echo "no gh token (gh auth login)" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "working tree not clean" >&2; exit 1; }
[ "$(git branch --show-current)" = main ] || { echo "not on main (the drill rebuilds what main says)" >&2; exit 1; }
KEYS="$HOME/.config/gitops-golden-path/age"
for k in local-01 dev prod; do
  [ -f "$KEYS/$k.agekey" ] || { echo "no root key at $KEYS/$k.agekey (stage 06 for local-01, stage 07 for dev and prod)" >&2; exit 1; }
done
# The robot's PR needs a repository setting the rebuild cannot restore; read it before
# destroying anything, or the fleet comes back with a robot that scans and cannot land.
[ "$(gh api "repos/{owner}/{repo}/actions/permissions/workflow" --jq .can_approve_pull_request_reviews 2>/dev/null)" = true ] \
  || { echo "Actions may not open PRs on this repo: the robot's PR cannot open after the rebuild (stage 14 step 4 sets can_approve_pull_request_reviews)" >&2; exit 1; }
git pull --ff-only
# shellcheck disable=SC1091
source ./env.sh

# --- helpers ------------------------------------------------------------------
say() { echo; echo "== $*"; }
secs() { echo $(( $(date -d "$2" +%s) - $(date -d "$1" +%s) )); }
wait_for() { # wait_for <timeout-secs> <description> <cmd...>
  local deadline; deadline=$(( $(date +%s) + $1 )); shift
  local desc=$1; shift
  echo -n "waiting for $desc "
  until "$@" >/dev/null 2>&1; do
    [ "$(date +%s)" -lt "$deadline" ] || { echo; echo "TIMEOUT: $desc" >&2; exit 1; }
    printf .; sleep 15
  done
  echo " ready"
}

# --- drill 1: the fleet from nothing, with a robot in it ------------------------
say "drill 1: fleet from nothing, with a robot in it"
for name in ggp-local-01 ggp-dev-01 ggp-prod-01; do CLUSTER_NAME=$name ./scripts/cluster-down; done

CLASS=platform CLUSTER_NAME=ggp-local-01 HTTP_PORT=8080 HTTPS_PORT=8443 ./scripts/cluster-up
CLASS=dev      CLUSTER_NAME=ggp-dev-01   HTTP_PORT=8081 HTTPS_PORT=8444 ./scripts/cluster-up
CLASS=prod     CLUSTER_NAME=ggp-prod-01  HTTP_PORT=8082 HTTPS_PORT=8445 ./scripts/cluster-up

# --write on the platform cluster only: the robot's privilege, paid as one flag (stage 14).
# The old 'flux local-01' key is replaced either way; the flag is what makes the new one
# read-write. The spokes keep read-only keys, as they have since stage 03.
./scripts/cluster-sync clusters/platform/local-01 --context kind-ggp-local-01 --write
./scripts/cluster-sync clusters/dev/dev-01 --context kind-ggp-dev-01
./scripts/cluster-sync clusters/prod/prod-01 --context kind-ggp-prod-01

# the surviving IOU: one root key per cluster. Each sync above ends with its decrypting
# stamps False (Secret "sops-age" not found): the key cannot exist before flux install
# creates its namespace, so it is paid here and the stamps retry at retryInterval (stage 08).
kubectl --context kind-ggp-local-01 -n flux-system create secret generic sops-age \
  --from-file=age.agekey="$KEYS/local-01.agekey"
kubectl --context kind-ggp-dev-01 -n flux-system create secret generic sops-age \
  --from-file=age.agekey="$KEYS/dev.agekey"
kubectl --context kind-ggp-prod-01 -n flux-system create secret generic sops-age \
  --from-file=age.agekey="$KEYS/prod.agekey"

# The hub address needs nothing here: cluster-facts names the hub by the platform node's
# container name, which the rebuilt node keeps. If your facts pin an IP instead (stage 09
# step 2's fallback), the spokes cannot reach the new node and this wait times out:
# refresh-hub-address, PR it, then re-run the checkpoints by hand.
# The sweep is the checkpoints the act's stages gate on: stage 16 held each rebuilt rung to
# checkpoint-06 on the platform cluster and checkpoint-07 across the fleet.
wait_for 900 "the fleet to converge (checkpoint-07; the monitoring stack is the heavy pull)" ./scripts/checkpoint-07
CTX=kind-ggp-local-01 ./scripts/checkpoint-06
./scripts/checkpoint-07

# The act's own objects, none of them asked for: the image objects from the platform
# binding, the Receiver from the same folder with its token through cluster-secrets. The
# Receiver reconciles on its own interval once the token has landed; the reconcile makes
# that a second, and the wait is the verdict. The automation is Ready only because the
# sync above ran with --write; without the flag it sits on "push: permission denied".
flux reconcile receiver app-artifact-published --context kind-ggp-local-01 || true
wait_for 300 "the image objects and the Receiver to be Ready" \
  kubectl --context kind-ggp-local-01 -n flux-system wait --for=condition=Ready --timeout=10s \
    imagerepository/app imagepolicy/app imageupdateautomation/app-dev receiver/app-artifact-published
flux get images all --context kind-ggp-local-01

# earliest cluster birth to the last app stamp's first successful reconcile anywhere -
# artifacts, not a stopwatch, and the same three stamps act-2-drill and act-3-drill time,
# so the numbers compare: the image controllers' pull is in the wait above, not in the number.
# status.history, not Ready's lastTransitionTime: with wait: true the Ready condition
# flips on every reconcile, so lastTransitionTime is the latest 5m tick, and the number
# would grow by up to one interval depending on when this script happens to read it
# (the same fleet read 537s at one minute and 846s five minutes later). A history
# entry's firstReconciled is written once.
t0=$(for ctx in kind-ggp-local-01 kind-ggp-dev-01 kind-ggp-prod-01; do
  kubectl --context "$ctx" get ns kube-system -o jsonpath='{.metadata.creationTimestamp}{"\n"}'; done | sort | head -1)
t1=$(for c in kind-ggp-local-01:app-dev kind-ggp-dev-01:app-dev kind-ggp-prod-01:app-prod; do
  kubectl --context "${c%%:*}" -n flux-system get kustomization "${c#*:}" -o json \
    | jq -r '[.status.history[]? | select(.lastReconciledStatus == "ReconciliationSucceeded") | .firstReconciled] | min'
  done | sort | tail -1)
D1=$(secs "$t0" "$t1")

say "results (paste-ready for act-checkpoint.md)"
echo "| Fleet-from-nothing | ${D1}s | $(date +%F) |"
echo
# The forge's only record of a rebuild is the deploy keys cluster-sync minted. No commit
# status is expected: the GitHub provider skips a post identical to the latest one already on
# the commit (notification-controller, internal/notifier/github.go, duplicateGithubStatus), so
# a fleet rebuilt to an unchanged main leaves the statuses exactly as the destroyed fleet left
# them. A checkpoint that counts contexts on HEAD is counting the old fleet's testimony.
echo "witnessed on the forge by (no status reposts on an unchanged commit):"
gh api "repos/{owner}/{repo}/keys" \
  --jq '.[] | select(.title | startswith("flux ")) | "  \(.title)  #\(.id)  read_only=\(.read_only)  created \(.created_at)"'
# The act's own assertion: the platform key is read-write, or the robot is down until it is.
rw=$(gh api "repos/{owner}/{repo}/keys" --jq '.[] | select(.title == "flux local-01") | .read_only')
[ "$rw" = false ] || { echo "FAIL  flux local-01 is read_only=${rw:-absent}: cluster-sync ran without --write; run it again with the flag (stage 14 step 1)" >&2; exit 1; }
echo "  the robot's privilege is back: flux local-01 is read-write"
