#!/usr/bin/env bash
# Lead time for one rung of the promotion ladder: from the commit that asked for the
# change to the commit status reporting it converged - measured honestly.
#
# The honesty is the point. Flux posts a status at the end of every reconcile, against
# whatever the source's HEAD is by then, so a reconcile that began BEFORE the fetch can
# post "success" on your brand-new commit while the old workload is still running. Read
# that status and a promotion looks 4 seconds long when it took 35. So: wait until the
# cluster says it applied THIS revision, wait for the rollout, then read the status.
#
# Usage: rung-time <sha> <status-context> <kube-context> <stamp>
set -uo pipefail

SHA="${1:?usage: rung-time <sha> <status-context> <kube-context> <stamp>}"
CTX="${2:?status context, e.g. kustomization/app-prod/prod-01}"
KCTX="${3:?kube context, e.g. kind-ggp-prod-01}"
STAMP="${4:?stamp name, e.g. app-prod}"
BRANCH="${RUNG_BRANCH:-main}"

t0=$(git log -1 --format=%cI "$SHA") || exit 2
want="$BRANCH@sha1:$SHA"
applied=""

echo "waiting for $KCTX to apply $want ..."
seen=no
for _ in $(seq 1 120); do
  applied=$(kubectl --context "$KCTX" -n flux-system get kustomization "$STAMP" \
    -o jsonpath='{.status.lastAppliedRevision}' 2>/dev/null)
  if [ "$applied" = "$want" ]; then seen=yes; break; fi
  # Already moved past it? Then the apply happened; measuring after the fact is fine.
  if [ -n "$applied" ] && git merge-base --is-ancestor "$SHA" "${applied##*sha1:}" 2>/dev/null; then
    echo "note: $STAMP is now on $applied - $want was applied earlier, reading its status"
    seen=yes; break
  fi
  sleep 5
done
[ "$seen" = yes ] || { echo "FAIL  $STAMP never applied $want (last: ${applied:-none})"; exit 1; }

kubectl --context "$KCTX" -n ggp rollout status deploy/app --timeout=5m >/dev/null || exit 1

t1=$(gh api "repos/{owner}/{repo}/commits/$SHA/status" \
  --jq ".statuses[] | select(.context == \"$CTX\") | .created_at" 2>/dev/null)
[ -n "$t1" ] || { echo "FAIL  no status yet for context $CTX on ${SHA:0:7}"; exit 1; }

echo "${SHA:0:7}  $CTX: $(( $(date -d "$t1" +%s) - $(date -d "$t0" +%s) ))s"
