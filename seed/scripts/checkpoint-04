#!/usr/bin/env bash
# Stage 04 checkpoint: the loop notifies, and the reconciled revision wears its status.
#
# Every line is PASS/FAIL + what it means; exits non-zero if anything failed. Note for the act
# checkpoint's cold start: the token secret is the stage-04 IOU. Before stage 06 it lives
# OUTSIDE git, so a rebuild loses it until stage 04 step 1 is re-run. From stage 06 on the
# debt consolidates: install the sops-age root key and git restores the token itself
# (cluster-secrets stamp) - the check below reads Flux's ownership labels to report which era
# it's seeing.
#
# Usage:
#   checkpoint-04
#
# Options:
#   -h, --help  this text
#
# Examples:
#   # PASS/FAIL per claim, exit 1 on any FAIL
#   ./scripts/checkpoint-04
#
# See also: stage 04; rule 5.1
set -uo pipefail
case "${1-}" in -h|--help) sed -n '2,/^\([^#]\|$\)/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0;; esac

REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)   # derived - no identity stored
pass=0; fail=0
ok()  { echo "PASS  $1"; pass=$((pass+1)); }
bad() { echo "FAIL  $1${2:+  [$2]}"; fail=$((fail+1)); }

echo "== checkpoint-04: the loop tells you =="

if kubectl -n flux-system get secret github-status-token >/dev/null 2>&1; then
  owner=$(kubectl -n flux-system get secret github-status-token \
    -o jsonpath='{.metadata.labels.kustomize\.toolkit\.fluxcd\.io/name}' 2>/dev/null)
  if [ -n "$owner" ]; then
    ok "token secret exists, git-restored via stamp '$owner' (the stage-04 IOU, paid in stage 06)"
  else
    ok "token secret exists (the IOU - imperative, outside git; a rebuild loses it by design)"
  fi
else
  bad "token secret exists" "pre stage 06: re-run stage 04 step 1; post: create the sops-age root-key secret, then flux reconcile kustomization cluster-secrets"
fi

kubectl -n flux-system get provider github-status >/dev/null 2>&1 \
  && ok "Provider github-status exists (where to tell)" || bad "Provider github-status exists"

kubectl -n flux-system get alert app-dev-status >/dev/null 2>&1 \
  && ok "Alert app-dev-status exists (what to tell it about)" || bad "Alert app-dev-status exists"

rev=$(kubectl -n flux-system get kustomization app-dev -o jsonpath='{.status.lastAppliedRevision}' 2>/dev/null)
sha=${rev##*:}
if [ -z "$sha" ]; then
  bad "applied revision known" "app-dev has no lastAppliedRevision"
else
  # select the app-dev context explicitly - from stage 05 on a commit wears several
  st=$(gh api "repos/$REPO/commits/$sha/status" \
    --jq '[.statuses[] | select(.context | startswith("kustomization/app-dev"))][0] | (.state // "-") + " " + (.context // "-")' 2>/dev/null)
  case "$st" in
    "success kustomization/app-dev"*) ok "reconciled revision (${sha:0:7}) wears a green app-dev status (loop live end-to-end)";;
    *) bad "reconciled revision (${sha:0:7}) wears a green app-dev status" "got: ${st:-no response} - statuses query the reconciled revision, not HEAD";;
  esac
fi

echo
echo "checkpoint-04: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
