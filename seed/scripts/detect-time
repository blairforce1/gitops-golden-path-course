#!/usr/bin/env bash
# How long from "someone broke prod" to "the fleet view knew" - measured from artifacts.
#
# The answer is a metric sample timestamp: kube-state-metrics reads the stamp's Ready
# condition into gotk_resource_info on the hub, so "when did we know" is a query, not a
# stopwatch and not a memory. What it prints is the state timeline either side of the
# break, which is the same thing your eyes do on the Grafana panel - one line per change.
#
# Deliberately NOT the commit status: a status is a snapshot one reconcile chose to post
# (drill 2 met one that was green and said "dependency not ready"). The
# metric is a continuous sample of the CR itself. Detection is a metric question;
# attribution is a status question. This script answers the first.
#
# Usage: detect-time <stamp> <kube-context> [break-commit-subject | sha] [window]
#   e.g. detect-time app-prod kind-ggp-prod-01              (a drill: the break is labelled)
#        detect-time app-prod kind-ggp-prod-01 e99aba0      (an incident: the break is a sha)
#
# The third argument is optional because the commit convention made the DRILL case
# derivable: a deliberate break against this stamp has the subject prefix "break(<stamp>): ",
# so naming the stamp already selects the commit. A real break is never labelled - it is a
# feat, a pin, a promote that happened to hurt - and it is found the other way round: the
# stamp's status.history names the revision that failed, and that sha is the anchor. Pass
# a sha and it is used as given; pass a subject and it is matched as a prefix.
set -uo pipefail

STAMP="${1:?usage: detect-time <stamp> <kube-context> [break-commit-subject | sha] [window]}"
KCTX="${2:?kube context the stamp runs on, e.g. kind-ggp-prod-01}"
SUBJECT="${3:-break($STAMP): }"          # derived from the grammar; a subject prefix or a sha overrides
WINDOW="${4:-30m}"                       # how long AFTER the break to look
# Era check first: the hub is stage 09's. Before it there is no metric store to ask, and
# "since when" comes from the stamp itself (status.history, its events while they last,
# the controller log after that) - SKIP, not FAIL.
[ -d infrastructure/monitoring-hub ] || { echo "SKIP  no monitoring hub in git yet (infrastructure/monitoring-hub lands at stage 09) - read the stamp's status.history and events instead"; exit 0; }
PORT="${DETECT_TIME_PORT:-19097}"
STEP=15                                  # resolution of the answer, in seconds
SUSTAIN="${DETECT_TIME_SUSTAIN:-60}"     # a not-Ready shorter than this is the cascade, not a break

secs() { case "$1" in *h) echo $(( ${1%h} * 3600 ));; *m) echo $(( ${1%m} * 60 ));; *s) echo "${1%s}";; *) echo "$1";; esac; }

# Find the break by its subject, never by HEAD - drill 2's lesson. A PREFIX of the subject
# field, anchored at the start by commit-by-subject: `git revert` writes Revert "<subject>",
# so the subject it undoes sits inside the line rather than at the start of it, and a
# substring search would find the revert (newer, and the opposite event).
if [[ "$SUBJECT" =~ ^[0-9a-f]{7,40}$ ]] && git rev-parse -q --verify "$SUBJECT^{commit}" >/dev/null 2>&1; then
  SHA=$(git rev-parse "$SUBJECT")          # an incident: the failed revision, named by status.history
else
  SHA=$("$(dirname "$0")/commit-by-subject" --prefix "$SUBJECT") || exit 1
fi
SUBJECT=$(git log -1 --format=%s "$SHA")   # print the subject found, not the prefix searched
t0=$(git log -1 --format=%ct "$SHA")

kubectl --context kind-ggp-local-01 -n monitoring port-forward svc/kube-prometheus-stack-prometheus \
  "$PORT:9090" >/dev/null 2>&1 &
PF=$!
trap 'kill "$PF" 2>/dev/null; wait "$PF" 2>/dev/null' EXIT
for _ in $(seq 1 20); do curl -s -o /dev/null "http://localhost:$PORT/-/ready" && break; sleep 1; done
curl -s -o /dev/null --max-time 5 "http://localhost:$PORT/-/ready" \
  || { echo "FAIL  hub reachable  [is the platform cluster up and the monitoring stamp Ready?]"; exit 1; }

t_end=$(( t0 + $(secs "$WINDOW") )); now=$(date +%s); [ "$t_end" -gt "$now" ] && t_end=$now

spec=$(kubectl --context "$KCTX" -n flux-system get kustomization "$STAMP" \
  -o jsonpath='{.spec.interval}{" "}{.spec.timeout}' 2>/dev/null)
interval=${spec%% *}; timeout=${spec##* }
[ -n "${timeout// }" ] || timeout="unset (defaults to the interval)"

# When the stamp has the series now, the hub's earliest sample of it tells "no such series"
# from "the store is younger than the break": a rebuilt hub (the act drills do this) holds
# the stamp from its rebirth on and nothing before.
born_json=$(curl -s --max-time 10 "http://localhost:$PORT/api/v1/query" \
  --data-urlencode "query=min(min_over_time(timestamp(gotk_resource_info{name=\"$STAMP\"})[7d:5m]))")

# Two minutes of "before" so the healthy state it broke FROM is on screen too.
curl -s --max-time 20 "http://localhost:$PORT/api/v1/query_range" \
  --data-urlencode "query=gotk_resource_info{name=\"$STAMP\"}" \
  --data-urlencode "start=$(( t0 - 120 ))" --data-urlencode "end=$t_end" \
  --data-urlencode "step=$STEP" \
| SHA="${SHA:0:7}" SUBJECT="$SUBJECT" T0="$t0" STAMP="$STAMP" KCTX="$KCTX" \
  INTERVAL="$interval" TIMEOUT="$timeout" WINDOW="$WINDOW" STEP="$STEP" \
  T_END="$t_end" SUSTAIN="$SUSTAIN" BORN_JSON="$born_json" python3 -c '
import json, os, sys, datetime
from collections import defaultdict

t0 = int(os.environ["T0"]); stamp = os.environ["STAMP"]
try:
    result = json.load(sys.stdin)["data"]["result"]
except Exception:
    print("FAIL  the hub returned no readable answer  [is Prometheus up?]"); sys.exit(2)

# One row per sample time, holding whatever ready= values existed then. Collapsing the
# other labels is the point: we want WHEN the state changed, not which revision it named.
at = defaultdict(set)
for series in result:
    ready = series["metric"].get("ready", "?")
    for ts, _ in series["values"]:
        at[int(float(ts))].add(ready)

hhmmss = lambda ts: datetime.datetime.fromtimestamp(ts).strftime("%H:%M:%S")
print()
print("break commit   %s  \"%s\"" % (os.environ["SHA"], os.environ["SUBJECT"]))
if not at:
    print("               pushed at %s\n" % hhmmss(t0))
    born = None
    try:
        r = json.loads(os.environ["BORN_JSON"])["data"]["result"]
        if r: born = int(float(r[0]["value"][1]))
    except Exception:
        pass
    if born and born > t0:
        print("FAIL  the hub knows %s only from %s, after the break: the store is younger than" % (stamp, hhmmss(born)))
        print("      the question. A rebuilt hub starts empty, and so does a rebuilt stamp; the")
        print("      numbers live in whatever record was made before the rebuild, and nowhere else.")
    else:
        print("FAIL  no gotk_resource_info for %s on the hub at all." % stamp)
        print("      Check the monitoring stamps are Ready fleet-wide: ./scripts/checkpoint-09")
    sys.exit(1)

before = [s for ts, s in sorted(at.items()) if ts <= t0]
was = ",".join(sorted(before[-1])) if before else "unseen"
print("               pushed at %s - %s was ready=%s" % (hhmmss(t0), stamp, was))
if was != "True":
    print("\nWARNING  %s was not green when the break landed. Everything below is about a" % stamp)
    print("         failure that was already there, not the one you just caused.")

print("\nwhat the hub saw (gotk_resource_info, %ss resolution):\n" % os.environ["STEP"])

# Collapse samples into segments: the question is never "what was the value at 13:22:10",
# it is "how long did it stay that way".
segments, prev = [], None
for ts in sorted(at):
    state = ",".join(sorted(at[ts]))
    if state != prev:
        segments.append([ts, state])
        prev = state
t_end = int(os.environ["T_END"])
for i, seg in enumerate(segments):
    seg.append(segments[i + 1][0] if i + 1 < len(segments) else t_end)

sustain = int(os.environ["SUSTAIN"]); step = int(os.environ["STEP"])
import re
dur = lambda s: sum(int(n) * {"h": 3600, "m": 60, "s": 1}[u] for n, u in re.findall(r"(\d+)([hms])", s))
timeout_s = dur(os.environ["TIMEOUT"])

# A short not-Ready is the dependency cascade - unless it is the verdict at the end of a full
# health check. Under a short retryInterval a failing stamp is False only for the gap between
# attempts (30s) and Unknown for the whole timeout in between, so the red never sustains: the
# False that follows a timeout-long Unknown is the stamp giving up, however brief.
def verdict(i):
    start, state, end = segments[i]
    if "False" not in state or i == 0:
        return False
    ps, pstate, pe = segments[i - 1]
    return "Unknown" in pstate and pe - ps >= max(timeout_s - step, sustain)
def transient(i):
    start, state, end = segments[i]
    return start > t0 and state != "True" and end - start < sustain and not verdict(i)

left_ready = confirmed = None
for i, (start, state, end) in enumerate(segments):
    if start <= t0 or state == "True" or transient(i):
        continue
    if left_ready is None:
        left_ready = start
    if "False" in state:
        confirmed = start
        break

for i, (start, state, end) in enumerate(segments):
    delta = "" if start <= t0 else "+%ds" % (start - t0)
    note = ""
    if transient(i):
        note = "   transient (%ds) - the dependency cascade, not your break" % (end - start)
    elif start == left_ready:
        note = "   <- left Ready: the dashboard can see something is wrong"
    elif start == confirmed:
        note = "   <- confirmed red: the stamp gave up"
    elif start > t0 and state == "True" and confirmed and start > confirmed:
        note = "   recovered"
    print(("  %s  %7s   ready=%-8s%s" % (hhmmss(start), delta, state, note)).rstrip())

print()
if left_ready is None:
    print("nothing but transient flicker within %s of the break." % os.environ["WINDOW"])
    print("Either the stamp is still waiting out its timeout (%s) - re-run in a minute -" % os.environ["TIMEOUT"])
    print("or detection took longer than the window; widen it with a 4th argument, e.g. 2h.")
    sys.exit(1)

print("break -> left Ready:    %4ds" % (left_ready - t0))
if confirmed:
    print("break -> confirmed red: %4ds   (%ds of that spent waiting out timeout %s)"
          % (confirmed - t0, confirmed - left_ready, os.environ["TIMEOUT"]))
else:
    print("break -> confirmed red:    -   (not yet - still inside timeout %s)" % os.environ["TIMEOUT"])
print()
print("  %s on %s: interval %s, timeout %s." % (stamp, os.environ["KCTX"], os.environ["INTERVAL"], os.environ["TIMEOUT"]))
print("  Transient rows above are real and expected: a stamp waiting on its dependsOn reports")
print("  Ready=False, so every push reds the dependent fleet for one retry. Duration, not")
print("  colour, separates ordering from failure - and it is why an alert on this metric")
print("  needs a `for:` window. Why it failed is a different tool:")
print("  flux events --context %s --for Kustomization/%s" % (os.environ["KCTX"], stamp))
'
