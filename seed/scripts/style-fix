#!/usr/bin/env bash
# Format YAML in place with kustofmt (the format authority behind scripts/style-gate).
# gofmt's shape: -l lists the files whose bytes differ from the emitted style, -w
# rewrites exactly those, so the script can say which files it touched. The binary
# is the pinned one or nothing: the pin lives in clusters/versions.yaml and
# check-kustofmt-kustomize-parity names the install.
# Usage: style-fix [files...]   (no args = every tracked YAML outside tool-owned trees)
set -uo pipefail

KUSTOFMT_V=$(yq -r '.kustofmt // ""' clusters/versions.yaml 2>/dev/null)
[ -n "$KUSTOFMT_V" ] || { echo "FAIL  kustofmt pinned in clusters/versions.yaml  [stage 11 step 1 pins it]"; exit 1; }
have=$(kustofmt -version 2>/dev/null | awk 'NR == 1 { print $2 }')
[ "$have" = "$KUSTOFMT_V" ] \
  || { echo "FAIL  installed kustofmt is the pin  [have ${have:-none}, want $KUSTOFMT_V - scripts/check-kustofmt-kustomize-parity names the install]"; exit 1; }

# flux-system/ is `flux install --export` output: never rewritten, whatever list is given
# (the exemption style-gate and layout-gate hold; kustofmt has no ignore file by design).
if [ $# -gt 0 ]; then
  files=("$@")
else
  mapfile -t files < <(git ls-files '*.yaml' '*.yml')
fi
judged=()
for f in "${files[@]}"; do
  case "$f" in
    */flux-system/*) [ $# -gt 0 ] && echo "SKIP  $f  [flux-system: flux install --export output, the tool's style]";;
    *) judged+=("$f");;
  esac
done
files=("${judged[@]}")
[ ${#files[@]} -gt 0 ] || { echo "style-fix: 0 file(s) formatted"; exit 0; }

# -l skips sops-encrypted files itself and leaves an unparseable file unlisted (its
# error goes to stderr); only what it lists is rewritten, deliberately.
mapfile -t need < <(kustofmt -l "${files[@]}" 2>/dev/null)
if [ ${#need[@]} -gt 0 ]; then
  kustofmt -w "${need[@]}" && printf 'formatted  %s\n' "${need[@]}"
fi
echo "style-fix: ${#need[@]} file(s) formatted"
