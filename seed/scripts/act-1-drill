#!/usr/bin/env bash
# Act I drill runner: re-earns the act checkpoint's four numbers, unattended.
# DESTRUCTIVE - it deletes and rebuilds the kind cluster, pushes a dated
# pre-release tag to the app repo (triggering a GHCR publish), and pushes three
# real PRs here (pin bump, deliberate break, revert) and merges them. Guarded by --yes.
# Timings are extracted from artifacts (commit stamps, status created_at,
# condition transitions) - no stopwatch, same rule as act-checkpoint.md.
set -euo pipefail

APP_DIR="${APP_DIR:-../gitops-golden-path-app}"   # relative to this repo's root

cd "$(dirname "$0")/.."
# identity derives from the remotes - no account names stored anywhere in the tutorial
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)

if [ "${1:-}" != "--yes" ]; then
  cat <<EOF
act-1-drill re-runs the Act I checkpoint drills end to end. It will:
  1. DELETE and rebuild the kind cluster (cluster-down/up + cluster-sync)
  2. push a dated pre-release tag to $APP_DIR (GHCR publish)
  3. open and merge three PRs here: pin bump, deliberate break, revert
Nothing is simulated. Run with --yes to proceed.
EOF
  exit 1
fi

# --- preflight: fail before any damage ---------------------------------------
for t in docker flux gh git kind kubectl kustomize; do
  command -v "$t" >/dev/null || { echo "MISSING: $t" >&2; exit 1; }
done
[ -n "$(gh auth token 2>/dev/null)" ] || { echo "no gh token (gh auth login)" >&2; exit 1; }
[ -d "$APP_DIR/.git" ] || { echo "app repo not at $APP_DIR (set APP_DIR)" >&2; exit 1; }
IMAGE="ghcr.io/$( (cd "$APP_DIR" && gh repo view --json nameWithOwner -q .nameWithOwner) | tr '[:upper:]' '[:lower:]')"
[ -z "$(git status --porcelain)" ] || { echo "working tree not clean" >&2; exit 1; }
# post-stage-06 repos (.sops.yaml in git) need the root key to rebuild - fail before damage
[ ! -f .sops.yaml ] || [ -f "$HOME/.config/gitops-golden-path/age/local-01.agekey" ] || {
  echo "post-stage-06 repo but no root key at ~/.config/gitops-golden-path/age/local-01.agekey (stage 06 steps 1+3)" >&2; exit 1; }
[ -z "$(git -C "$APP_DIR" status --porcelain)" ] || { echo "app working tree not clean" >&2; exit 1; }
git pull --ff-only
git -C "$APP_DIR" pull --ff-only

# --- helpers ------------------------------------------------------------------
say() { echo; echo "== $*"; }
secs() { echo $(( $(date -d "$2" +%s) - $(date -d "$1" +%s) )); }
status_is() { [ "$(gh api "repos/$REPO/commits/$1/status" --jq .state 2>/dev/null)" = "$2" ]; }
wait_for() { # wait_for <timeout-secs> <description> <cmd...>
  local deadline; deadline=$(( $(date +%s) + $1 )); shift
  local desc=$1; shift
  until "$@" >/dev/null 2>&1; do
    [ "$(date +%s)" -lt "$deadline" ] || { echo "TIMEOUT: $desc" >&2; exit 1; }
    sleep 10
  done
  echo "ready: $desc"
}
lead_secs() { # lead_secs <sha> [success|failure]: commit stamp -> the app stamp's own status of that state
  # Every non-error event posts as success, so a green must also say "reconciliation
  # succeeded"; and the context is selected, never .statuses[0], which is whichever
  # stamp on the cluster posted last. Both server/artifact times.
  local t0 t1 want=${2:-success}
  t0=$(git log -1 --format=%cI "$1")
  t1=$(gh api "repos/$REPO/commits/$1/statuses?per_page=100" \
       --jq "[.[] | select((.context | startswith(\"kustomization/app-dev\")) and .state == \"$want\"
                and (\"$want\" == \"failure\" or .description == \"reconciliation succeeded\"))]
             | sort_by(.created_at) | .[0].created_at // empty")
  [ -n "$t1" ] || { echo "no $want status for kustomization/app-dev on ${1:0:7}" >&2; return 1; }
  secs "$t0" "$t1"
}
merge_pr() { # the drill is the reviewer here: the diff is the one it just wrote
  if [ -d .github/workflows ]; then   # from stage 08 a ruleset requires the check: wait for it to register and report
    for _ in 1 2 3 4 5 6; do gh pr checks --watch --fail-fast >/dev/null 2>&1 && break; sleep 10; done
  fi
  gh pr merge --merge --delete-branch >/dev/null
  git switch -q main && git pull -q --ff-only
}

# --- drill 2 prerequisite, started first so GHCR builds while the cluster rebuilds
TAG="v0.1.1-run$(date +%Y%m%d%H%M%S)"
IMGTAG="${TAG#v}"
say "minting app release $TAG (multi-arch build runs concurrently with drill 1)"
git -C "$APP_DIR" tag "$TAG"
git -C "$APP_DIR" push origin "$TAG"

# --- drill 1: platform from nothing -------------------------------------------
say "drill 1: cold start"
./scripts/cluster-down
./scripts/cluster-up
./scripts/cluster-sync clusters/platform/local-01
# pay the era's IOU: post stage 06 the debt is one root key and git restores the
# rest (cluster-secrets decrypts the token back); pre stage 06 it's the raw token
if [ -f .sops.yaml ]; then
  kubectl -n flux-system create secret generic sops-age \
    --from-file=age.agekey="$HOME/.config/gitops-golden-path/age/local-01.agekey"
else
  kubectl -n flux-system create secret generic github-status-token \
    --from-literal=token="$(gh auth token)"
fi
wait_for 900 "platform green (checkpoint-03)" ./scripts/checkpoint-03
t0=$(kubectl get ns kube-system -o jsonpath='{.metadata.creationTimestamp}')
# the stamp's first successful reconcile, from status.history: Ready's lastTransitionTime
# moves on every reconcile under wait: true, so it would read the latest tick, not the first
t1=$(kubectl -n flux-system get kustomization app-dev -o json \
  | jq -r '[.status.history[]? | select(.lastReconciledStatus == "ReconciliationSucceeded") | .firstReconciled] | min')
D1=$(secs "$t0" "$t1")
echo "platform-from-nothing: ${D1}s"

# --- drill 2: a real change, no kubectl ----------------------------------------
say "drill 2: lead time"
wait_for 1200 "GHCR image $IMGTAG" docker manifest inspect "$IMAGE:$IMGTAG"
(cd apps/overlays/dev && kustomize edit set image "$IMAGE:$IMGTAG")
git add apps/overlays/dev
./scripts/pr-open drill-pin "pin(app-dev): app $IMGTAG" <<EOF >/dev/null
## What is moving
Dev's app pin to $IMGTAG, the release this drill minted.

## Why now
Act I drill 2: lead time, merge to green, unattended.

## Evidence
The image exists on GHCR (polled before this PR was opened).

## If it is wrong
Drill 3 breaks and restores this rung deliberately.

Refs: #6
EOF
merge_pr
sha2=$(git rev-parse HEAD)
wait_for 600 "app-dev green on ${sha2:0:7}" lead_secs "$sha2"
D2=$(lead_secs "$sha2")
echo "merge->green: ${D2}s"

# --- drill 3: break and restore -------------------------------------------------
say "drill 3: detection and restore"
(cd apps/overlays/dev && kustomize edit set image "$IMAGE:9.9.9")
git add apps/overlays/dev
./scripts/pr-open drill-break "break(app-dev): absent image" <<EOF >/dev/null
## What is moving
Dev's app pin to 9.9.9, which does not exist.

## Why now
Act I drill 3: a health failure must go red and be restored, unattended.

## Evidence
None - that is the test.

## If it is wrong
The next PR reverts this merge.

Refs: #6
EOF
merge_pr
sha3=$(git rev-parse HEAD)
# known issue on Flux 2.8.8: no failure status ever posts (notification-controller#1373,
# fixed in 2.9) - this wait times out there; the red is the expected outcome from 2.9 on
wait_for 900 "app-dev red on ${sha3:0:7}" lead_secs "$sha3" failure
D3=$(lead_secs "$sha3" failure)
echo "break->red: ${D3}s"
# waiting for the detection above IS the pacing: the revert lands >=1 source interval later
git switch -q -c drill-restore && git revert -m 1 --no-edit HEAD && git push -q -u origin drill-restore
gh pr create --title "$(git log -1 --format=%s)" --body "Act I drill 3: restore after the deliberate break. git revert wrote the subject.

Refs: #6" >/dev/null
merge_pr
sha4=$(git rev-parse HEAD)
wait_for 600 "app-dev green on ${sha4:0:7}" lead_secs "$sha4"
D4=$(lead_secs "$sha4")
echo "revert->green: ${D4}s"

# --- drill 4: the evidence question, answered by query --------------------------
say "drill 4: the evidence dossier"
sha=$(scripts/commit-by-subject "pin(app-dev): app $IMGTAG")  # whole subject known: exact, first-parent = the merge, not the branch commit
git log -1 --format='change:   %h  %s%nauthor:   %an <%ae>%nwhen:     %cI' "$sha"
# a merge carries no diff of its own - diff against the first parent, the PR's whole change
git diff-tree --no-commit-id --stat "$sha^" "$sha" | sed 's/^ */          /'
gh api "repos/$REPO/commits/$sha/status" \
  --jq '.statuses[] | select(.context | startswith("kustomization/app-dev")) | "outcome:  \(.state)  (\(.context), \(.created_at))"'
rev=$(kubectl -n flux-system get kustomization app-dev -o jsonpath='{.status.lastAppliedRevision}')
echo "running:  $rev"
git merge-base --is-ancestor "$sha" "${rev##*:}" \
  && echo "included: yes - the change is an ancestor of the applied revision"

# --- close out ------------------------------------------------------------------
say "final checkpoints"
./scripts/checkpoint-03
./scripts/checkpoint-04

say "results (paste-ready for act-checkpoint.md)"
today=$(date +%F)
echo "| Platform-from-nothing | ${D1}s | $today |"
echo "| Merge -> green (lead time) | ${D2}s | $today |"
echo "| Break -> red (detection) | ${D3}s | $today |"
echo "| Revert -> green (restore) | ${D4}s | $today |"
echo
echo "end state: dev overlay pinned to $IMGTAG (the run's release); tree clean; loop green"
