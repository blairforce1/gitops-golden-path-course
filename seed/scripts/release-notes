#!/usr/bin/env bash
# Release notes for one cluster, from what that cluster says it is running.
#
# The premise: a fleet has no single "release". Three clusters share one repo and each is at
# its own revision, so "what shipped" is only ever a question about a cluster. Flux already
# records the answer - a stamp's .status.lastAppliedRevision is the commit that cluster
# actually applied - which makes the range a query rather than a tagging ceremony. No tags, no
# release branches, no changelog file to keep honest.
#
# Two views, and the difference is why merge-commit-only matters:
#
# Usage:
#   release-notes <stamp> <kube-context> [since] [--gap <stamp>@<kube-context>] [--first-parent] [--record]
#
# Arguments:
#   stamp, kube-context  the stamp and the cluster it runs on
#   since                a git revision to report from (default: the recorded point, else the root)
#
# Options:
#   --gap <stamp>@<kube-context>  the promotion gap: from what THIS stamp runs to what that one
#                                 runs, filtered to this stamp's inputs, because the question is
#                                 what this rung will render after the promotion. Not with since
#                                 or --record
#   --first-parent  one line per PR: what shipped, as reviewed
#   --record        remember this run's revision in .release-notes/, so the next run reports since it
#   -h, --help      this text
#
# Environment:
#   CLIFF_IMAGE  the pinned git-cliff container (default docker.io/orhunp/git-cliff:2.13.1)
#
# Examples:
#   # what prod is running, as reviewed
#   ./scripts/release-notes app-prod kind-ggp-prod-01 --first-parent
#   # the promotion gap: what prod will get from dev
#   ./scripts/release-notes app-prod kind-ggp-prod-01 --gap app-dev@kind-ggp-dev-01 --first-parent
#
# See also: stage 26; promote (the skill reads the gap this way)
set -uo pipefail
case "${1-}" in -h|--help) sed -n '2,/^\([^#]\|$\)/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0;; esac

CLIFF="${CLIFF_IMAGE:-docker.io/orhunp/git-cliff:2.13.1}"

STAMP="${1:?usage: release-notes <stamp> <kube-context> [since] [--gap <stamp>@<kube-context>] [--first-parent] [--record]}"
KCTX="${2:?kube context the stamp runs on, e.g. kind-ggp-prod-01}"
shift 2
SINCE=''; GAP=''; FP=''; RECORD=''
while [ $# -gt 0 ]; do
  case "$1" in
    --gap)          GAP="${2:?--gap needs <stamp>@<kube-context>}"; shift ;;
    --first-parent) FP='--first-parent' ;;
    --record)       RECORD=1 ;;
    -*)             echo "FAIL  unknown flag $1"; exit 2 ;;
    *)              SINCE="$1" ;;
  esac
  shift
done
case "$SINCE" in *@*) echo "FAIL  '$SINCE' looks like a rung; the promotion gap is --gap $SINCE"; exit 2 ;; esac
[ -n "$GAP" ] && [ -n "$SINCE" ] && { echo "FAIL  --gap and since are two different ranges; give one"; exit 2; }
[ -n "$GAP" ] && [ -n "$RECORD" ] && { echo "FAIL  --record needs this cluster's own range, not a gap  [drop --gap or --record]"; exit 2; }
case "$GAP" in ?*@?*|'') ;; *) echo "FAIL  --gap wants <stamp>@<kube-context>, got '$GAP'"; exit 2 ;; esac

# What the cluster says it is running. Flux writes "<branch>@sha1:<full-sha>"; take the sha.
revision_of() {
  kubectl --context "$2" -n flux-system get kustomization "$1" \
    -o jsonpath='{.status.lastAppliedRevision}' 2>/dev/null | sed 's/.*sha1://'
}

RUNNING=$(revision_of "$STAMP" "$KCTX")
[ -n "$RUNNING" ] || { echo "FAIL  $STAMP on $KCTX reports no lastAppliedRevision  [stamp exists? ever reconciled?]"; exit 1; }
git cat-file -e "$RUNNING^{commit}" 2>/dev/null \
  || { echo "FAIL  $KCTX is running $RUNNING, which is not in this clone  [git fetch? history rewritten?]"; exit 1; }

# The range. Plain: from a point in this cluster's past up to what it runs now. --gap: from
# what THIS cluster runs up to what the other rung runs - the direction matters, because
# git's A..B is "reachable from B, not from A", and prod's commit is an ancestor of dev's on
# a ladder. dev..prod is empty; prod..dev is the promotion gap.
STATE=".release-notes/${KCTX}.${STAMP}"
if [ -n "$GAP" ]; then
  FROM="$RUNNING"
  TO=$(revision_of "${GAP%@*}" "${GAP#*@}")
  [ -n "$TO" ] || { echo "FAIL  $GAP reports no lastAppliedRevision  [stamp exists on that cluster? ever reconciled?]"; exit 1; }
  git cat-file -e "$TO^{commit}" 2>/dev/null \
    || { echo "FAIL  ${GAP#*@} is running $TO, which is not in this clone  [git fetch? history rewritten?]"; exit 1; }
else
  TO="$RUNNING"
  case "$SINCE" in
    '')  FROM=$( [ -f "$STATE" ] && cat "$STATE" || git rev-list --max-parents=0 HEAD | tail -1 ) ;;
    *)   FROM=$(git rev-parse "$SINCE^{commit}" 2>/dev/null) \
           || { echo "FAIL  '$SINCE' is not a revision in this repo"; exit 1; } ;;
  esac
fi
git merge-base --is-ancestor "$FROM" "$TO" 2>/dev/null \
  || { echo "FAIL  ${FROM:0:7} is not an ancestor of ${TO:0:7}  [the two points have diverged; git log --oneline ${FROM:0:7}...${TO:0:7}]"; exit 1; }

# Which paths render to THIS cluster. The stamp knows its own: spec.path. Everything that
# path *includes* reaches it too, which is why base and components are in the set - a base
# edit ships to every cluster with no promotion, and a release note that hides that is
# worse than none. This is an approximation, deliberately named as one: the exact test is
# whether the RENDER changed (stage 12), and computing the true dependency set from a
# kustomization graph is the job the bespoke tool in this stage's last section exists for.
SPEC_PATH=$(kubectl --context "$KCTX" -n flux-system get kustomization "$STAMP" \
              -o jsonpath='{.spec.path}' 2>/dev/null | sed 's|^\./||')
PATHS=("$SPEC_PATH" apps/base apps/components)

printf 'cluster        %s\n' "$KCTX"
printf 'stamp          %s   (renders %s)\n' "$STAMP" "${SPEC_PATH:-<unknown>}"
printf 'running        %s   %s\n' "${RUNNING:0:7}" "$(git log -1 --format=%cI "$RUNNING")"
if [ -n "$GAP" ]; then
  printf 'gap to         %s   %s   (%s on %s)\n' "${TO:0:7}" "$(git log -1 --format=%cI "$TO")" "${GAP%@*}" "${GAP#*@}"
else
  printf 'since          %s   %s\n' "${FROM:0:7}" "$(git log -1 --format=%cI "$FROM")"
fi
printf 'view           %s\n' "$([ -n "$FP" ] && echo 'per PR (--first-parent)' || echo 'per commit')"
echo

if [ "$FROM" = "$TO" ]; then
  echo "nothing to report - the two points are the same revision"
  exit 0
fi

RANGE="$FROM..$TO"
TOTAL=$(git log $FP --format=%H "$RANGE" | wc -l)
mapfile -t SHAS < <(git log $FP --format=%H "$RANGE" -- "${PATHS[@]}")

if [ ${#SHAS[@]} -eq 0 ]; then
  echo "no commits in $RANGE touched anything this cluster renders"
  echo "(the fleet moved; this cluster's inputs did not - reconcile scope is the repo,"
  echo " change scope is the paths a commit touched)"
  exit 0
fi

printf 'commits        %d of %d in the range touch this cluster'"'"'s inputs\n\n' "${#SHAS[@]}" "$TOTAL"

if [ -n "$FP" ]; then
  # git-cliff has no --first-parent, so the PR-level view is plain git log. Nothing is
  # lost: at PR granularity the merge subject IS the release note, which is the whole
  # reason merge_commit_title=PR_TITLE is set (appendices/git-policy.md).
  git log --first-parent --format='- %s (%h)' "$RANGE" -- "${PATHS[@]}"
  exit 0
fi

INC=()
for p in "${PATHS[@]}"; do [ -n "$p" ] && INC+=(--include-path "$p/**"); done

# git-cliff runs as a pinned container (tool-provisioning rule: a pure function over the
# repo). Three flags earn their place, each found the hard way:
#   :ro,z            a filter reads, and SELinux hosts deny unlabeled mounts
#   safe.directory   the repo is owned by a uid the container does not have; without this
#                    git refuses to read it, complaining about dubious ownership
#   --tmpfs          git-cliff caches changed-files under .git/git-cliff-core, which a
#                    read-only mount denies. A tmpfs layered over exactly that path keeps
#                    the repo read-only and gives the cache somewhere to live.
docker run --rm -v "$PWD:/app:ro,z" --tmpfs /app/.git/git-cliff-core -w /app \
  -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/app \
  "$CLIFF" --config cliff.toml "${INC[@]}" "$RANGE" \
  || { echo "(git-cliff unavailable - plain log)"; git log --format='- %s (%h)' "$RANGE" -- "${PATHS[@]}"; }

if [ -n "$RECORD" ]; then
  mkdir -p .release-notes && printf '%s\n' "$TO" > "$STATE"
  echo
  echo "recorded  $STATE -> ${TO:0:7}   (next run reports from here)"
fi
