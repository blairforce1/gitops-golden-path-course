#!/usr/bin/env bash
# Does this change cite a work item that exists, and is open? PASS/FAIL per issue.
#
# PASS/FAIL per issue, exit 1 on any FAIL.
#
# Reads the Closes:/Refs: trailers (rule 2.5) - one per line, `Refs: #9` or `Refs: #9, #12`.
# Every number must be an issue in THIS repo (not a pull request) and, before the merge, open:
# a closed work item is finished work, and a change citing it is a change nobody asked for.
#
# Usage:
#   issue-gate [--landed] "<body>"
#   issue-gate [--landed] --file <path>
#
# Arguments:
#   body  a PR body or commit message with its Refs:/Closes: trailers
#
# Options:
#   --file <path>  read the body from a file
#   --landed       the change has merged: a closed item is fine, the merge may have closed it
#   -h, --help     this text
#
# Environment:
#   GH_REPO  the repository (default: the one gh sees)
#
# Examples:
#   # a body before pr-open
#   ./scripts/issue-gate "$(cat body.md)"
#   # the merge, as CI's push run judges it
#   ./scripts/issue-gate --landed "$(git log -1 --format=%B)"
#
# See also: rule 2.5; pr-open; CI's pr-record job
set -uo pipefail
case "${1-}" in -h|--help) sed -n '2,/^\([^#]\|$\)/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0;; esac
landed=0
[ "${1:-}" = --landed ] && { landed=1; shift; }
case "${1:-}" in
  --file) body="$(cat "${2:?usage: issue-gate --file <path>}")" ;;
  "") echo 'usage: issue-gate [--landed] "<body>" | --file <path>'; exit 2 ;;
  *) body="$1" ;;
esac
repo="${GH_REPO:-$(gh repo view --json nameWithOwner -q .nameWithOwner)}"

nums="$(printf '%s\n' "$body" | grep -E '^(Closes|Refs): ' | grep -oE '#[0-9]+' | tr -d '#' | sort -un)"
if [ -z "$nums" ]; then
  echo "FAIL  no Closes:/Refs: trailer - every change cites the work item it advances (rule 2.5)"
  exit 1
fi
fails=0
err=$(mktemp); trap 'rm -f "$err"' EXIT
for n in $nums; do
  if ! j="$(gh api "repos/$repo/issues/$n" 2>"$err")"; then
    # a 404 is a missing issue; anything else is the caller's token or the network,
    # and saying "does not exist" for a 403 sends the reader to the wrong fix
    if grep -q 'HTTP 404' "$err"; then
      echo "FAIL  #$n does not exist in $repo"
    else
      echo "FAIL  cannot read #$n in $repo - $(head -1 "$err") (a token without issues: read? in CI, the job's permissions: block)"
    fi
    fails=$((fails + 1)); continue
  fi
  if printf '%s' "$j" | jq -e '.pull_request' >/dev/null; then
    echo "FAIL  #$n is a pull request, not a work item"; fails=$((fails + 1)); continue
  fi
  state="$(printf '%s' "$j" | jq -r .state)"; title="$(printf '%s' "$j" | jq -r .title)"
  if [ "$state" != open ] && [ "$landed" = 0 ]; then
    echo "FAIL  #$n is $state - \"$title\" is finished work; a change citing it is a change nobody asked for"; fails=$((fails + 1)); continue
  fi
  echo "PASS  #$n $state - \"$title\""
done
[ "$fails" -eq 0 ]
