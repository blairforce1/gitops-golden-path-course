#!/usr/bin/env bash
# tools/gen-scripts-appendix - write appendices/scripts.md from the seeded scripts' headers
# and the skills' front matter: the menu ./scripts/help prints, as a page.
#   tools/gen-scripts-appendix           write the page
#   tools/gen-scripts-appendix --check   exit 1 if the page is not what the headers say
set -uo pipefail
cd "$(dirname "$0")/.."
out=appendices/scripts.md
family() {
  case "$1" in
    cluster-*) echo "1|The fleet's lifecycle|Create, point and delete the kind clusters; every rebuild drill is these three in order.";;
    checkpoint-*) echo "2|Stage checkpoints|Is my fleet green: one script per stage, PASS/FAIL per claim, the same file CI runs.";;
    check|check-*) echo "3|Toolchain and ladder checks|Are my tools and pins right: every check-* script, and check runs them all.";;
    act-*-drill) echo "4|Act drills|The fleet from nothing, unattended, with the number from artifacts; run-drill runs them and writes the pack.";;
    *-gate|style-fix) echo "5|Gates|One class of evidence, one verdict: the same file as a paste block, in CI and from a hook.";;
    pr-*|commit-by-subject|ruleset|help) echo "6|The forge|PRs, reverts, rulesets and the commit a subject names.";;
    *-time|dora|evidence|release-notes|slo-watch) echo "7|Evidence and measures|Numbers from artifacts, never a stopwatch: lead time, detection, DORA, the dossier, what shipped.";;
    *) echo "8|Tools|The rest.";;
  esac
}
gen() {
  echo "<!-- generated by tools/gen-scripts-appendix from the scripts' own headers; edit a header, not this page -->"
  echo "<!-- vale off -->"
  echo "# The scripts"
  echo
  echo "[Walkthrough index](../README.md) · [The operating skills](operating-skills.md) · [Take it to production](take-it-to-production.md)"
  echo
  echo "Every script stage 00 seeds into your config repo, with what it does, how it is called and an example: the page form of \`./scripts/help\`, read off the same headers that \`<name> --help\` prints. Run any of them from the repo root as \`./scripts/<name>\`. The families are the name prefixes; the [scripts README](../seed/scripts/README.md) has the long-form table and the header layout a new script follows."
  for fam in 1 2 3 4 5 6 7 8; do
    title=""; blurb=""
    for s in seed/scripts/*; do
      [ -x "$s" ] || continue; n=${s##*/}; [ "$n" = help ] && continue
      f=$(family "$n"); [ "${f%%|*}" = "$fam" ] || continue
      if [ -z "$title" ]; then title=$(echo "$f" | cut -d'|' -f2); blurb=$(echo "$f" | cut -d'|' -f3); echo; echo "## $title"; echo; echo "$blurb"; fi
      echo; echo "### \`$n\`"; echo
      sed -n '2p' "$s" | sed 's/^# \{0,1\}//'; echo
      echo '```text'
      awk 'NR<=2{next} /^#/{ sub(/^# ?/,""); print; next } {exit}' "$s" | sed '1{/^$/d}'
      echo '```'
    done
  done
  echo; echo "## The operating skills"; echo
  echo "Claude Code skills seeded beside the scripts, one runbook each; [the operating skills](operating-skills.md) page says where each fits and where it stops."; echo
  echo "| Skill | Arguments | What it does |"; echo "|---|---|---|"
  for f in seed/.claude/skills/*/SKILL.md; do
    name=$(sed -n 's/^name: *//p' "$f" | head -1); hint=$(sed -n 's/^argument-hint: *//p' "$f" | head -1 | tr -d '"')
    d=$(awk '/^description:/{p=1; sub(/^description: *>?-? */,""); if ($0!="") {print; exit}; next} p && NF {print; exit}' "$f")
    printf '| `/%s` | `%s` | %s |\n' "$name" "$hint" "$(printf '%s' "$d" | sed 's/|/\\|/g')"
  done
  echo; echo "---"; echo; echo "**Next:** [Take it to production](take-it-to-production.md)"
}
if [ "${1-}" = "--check" ]; then
  diff -q <(gen) "$out" >/dev/null && { echo "PASS  appendices/scripts.md matches the scripts' headers"; exit 0; }
  echo "FAIL  appendices/scripts.md is stale: run tools/gen-scripts-appendix"; exit 1
fi
gen > "$out"; echo "wrote $out ($(wc -l < "$out") lines)"
