#!/usr/bin/env bash
# Does the course still point at what it says it points at?
# Course-side tooling (not seeded into config repos). Fourteen checks over the docs
# themselves: every relative link resolves, every stage file has a row in the
# README's act tables (and every row a file), every stage doc's nav and Next lines
# name real neighbours, counted claims about another document match it, every
# rules.md / using-the-course.md #anchor names a heading that actually exists there,
# every work-item number a stage cites is the one tools/seed-backlog gives that stage,
# every stage-number reference - in any of its surface forms - names a stage the
# roster has, with stage-link text agreeing with the file it points at, and every
# sh-fence comment stays inside the ~110-column render budget (using-the-course §3).
# Then the stage-shape checks (9-14), each a defect a reader met by pasting: a written
# file that is not an sh-fence heredoc, a step that is prose ("repeat step 2"), a Stop &
# measure bullet naming a command with no block to run it, a branch referenced that
# nothing creates, a merge block repeating the watch the block before it ended on, and
# a rule cited without its number.
# Usage: tools/docs-gate                       run the checks (from anywhere in the repo)
#        tools/docs-gate --stage-refs [NN]     print every stage-number reference (the
#                                              renumber worklist; over-inclusive when
#                                              filtered, by design)
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 2

# One extractor owns every surface form a stage reference takes: "stage 27",
# "Stage 27", "stage-27", "stages 28-32" (any dash), "stages 06/07/30",
# "stages 23, 29", "stages 06->30". The renumber lesson: sweeps done with ad-hoc
# regexes miss the odd forms, so the sweep must BE this extractor's output.
STAGEREF='[Ss]tages?[ -][0-9]{2}([^A-Za-z0-9]{1,3}[0-9]{2})*'
if [ "${1:-}" = --stage-refs ]; then
  want="${2:-}"
  git ls-files '*.md' | xargs grep -noE "$STAGEREF" 2>/dev/null |
    if [ -n "$want" ]; then grep -E "(^|[^0-9])0?$want([^0-9]|$)"; else cat; fi
  exit 0
fi
fails=0
pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; fails=$((fails + 1)); }
words="zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty"
num2word() { echo "$words" | tr ' ' '\n' | sed -n "$(($1 + 1))p"; }

# --- 1. every relative link resolves ---------------------------------------------
broken=""
while IFS= read -r src; do
  targets=$(grep -o '](\.\{0,2\}[^):]*\.\(md\|sh\)[^)]*)' "$src" 2>/dev/null |
            sed 's/^](//; s/)$//; s/#.*$//' | sort -u)
  for t in $targets; do
    [ -n "$t" ] || continue
    [ -e "$(dirname "$src")/$t" ] || broken="$broken$src -> $t"$'\n'
  done
done < <(git ls-files '*.md' | sort)
if [ -z "$broken" ]; then
  pass "every relative link in the course resolves"
else
  fail "dead links - a file moved and its referrers did not:"
  printf '%s' "$broken" | sed 's/^/        /'
fi

# --- 2. every stage file has a README row, and every row has a file ---------------
stagefiles=$(git ls-files 'act-*/stage-*.md' | sort)
rows=$(grep -o '](act-[0-9]/stage-[0-9][0-9]\.md)' README.md | tr -d '(])' | sort -u)
missing=$(comm -23 <(echo "$stagefiles") <(echo "$rows"))
ghosts=$(comm -13 <(echo "$stagefiles") <(echo "$rows"))
[ -z "$missing" ] && [ -z "$ghosts" ] &&
  pass "README act tables list all $(echo "$stagefiles" | wc -l) stage files, and nothing else"
[ -n "$missing" ] && { fail "stage files absent from the README act tables:"; echo "$missing" | sed 's/^/        /'; }
[ -n "$ghosts" ]  && { fail "README rows pointing at no file:";               echo "$ghosts"  | sed 's/^/        /'; }

# --- 3. nav line and Next line on every stage doc and checkpoint -----------------
navbad=""
while IFS= read -r f; do
  line3=$(sed -n '3p' "$f")
  case "$line3" in
    *"[Walkthrough index](../README.md)"*) ;;
    *) navbad="$navbad$f: line 3 is not a nav line"$'\n' ;;
  esac
  case "$(basename "$f")" in stage-00.md) continue ;; esac
  grep -q '^\*\*Next:\*\* ' "$f" || navbad="$navbad$f: no **Next:** line"$'\n'
done < <(git ls-files 'act-*/stage-*.md' 'act-*/act-checkpoint.md' | sort)
if [ -z "$navbad" ]; then
  pass "every stage and checkpoint has a nav line and a Next line"
else
  fail "navigation convention broken:"; printf '%s' "$navbad" | sed 's/^/        /'
fi

# --- 4. counted claims about another document ------------------------------------
declared=$(grep -c '^\*\*[0-9]\+\. ' appendices/commit-convention.md)
truth=$(num2word "$declared")
heading=$(grep -o '^## The [a-z]* deciding rules' appendices/commit-convention.md | awk '{print $3}')
claims=$(git ls-files '*.md' | xargs grep -ho '[a-z]* \(deciding \)\?rules that make' | awk '{print $1}' | sort -u)
bad=$(echo "$claims" | grep -v "^$truth$" || true)
if [ "$declared" -eq 0 ]; then
  fail "no numbered rules found in the commit convention - the count has nothing to check against"
elif [ -z "$bad" ] && [ "$heading" = "$truth" ]; then
  pass "every 'rules that make' count says '$truth', and the appendix defines $declared"
else
  fail "the commit convention defines $declared rules ($truth); prose elsewhere says: $(echo "$bad" | tr '\n' ' ')$([ "$heading" != "$truth" ] && echo "(its own heading says '$heading')")"
fi

# --- 5. every rules.md / using-the-course.md anchor names a real heading --------
# GitHub's slug algorithm: lowercase; drop everything but alphanumerics, spaces and
# hyphens; spaces become hyphens. Computed from each page's own headings so a reworded
# heading breaks its referrers loudly instead of silently.
badanchor=""; nanchors=0
for page in rules.md using-the-course.md; do
  slugs=$(grep '^#\{1,3\} ' "$page" | sed 's/^#* //' | tr '[:upper:]' '[:lower:]' |
          LC_ALL=C sed 's/[^a-z0-9 -]//g; s/ /-/g')
  pat="$(printf '%s' "$page" | sed 's/\./\\./g')#[a-z0-9-]*"
  nanchors=$((nanchors + $(git ls-files '*.md' | xargs grep -ho "$pat" 2>/dev/null | sort -u | wc -l)))
  while IFS= read -r f; do
    for a in $(grep -o "$pat" "$f" 2>/dev/null | sed 's/.*#//' | sort -u); do
      echo "$slugs" | grep -qx "$a" || badanchor="$badanchor$f -> $page#$a"$'\n'
    done
  done < <(git ls-files '*.md' | grep -vx "$page")
done
if [ -z "$badanchor" ]; then
  pass "every rules.md and using-the-course.md anchor resolves to a heading ($nanchors distinct anchors)"
else
  fail "anchors pointing at no heading - reworded or mis-slugged:"
  printf '%s' "$badanchor" | sed 's/^/        /'
fi

# --- 6. every work-item number a stage cites is that stage's own issue --------------------
# The roster is the README's act tables (tools/seed-backlog --roster); a stage's Refs: trailers
# and its gh issue close line must name the number the seeder gives that stage - counted
# only inside ```sh fences (what a reader types); prose examples and --grep queries are not.
badref=""
declare -A OWN   # canonical number per roster entry, keyed two ways for the prose scan
while IFS=$'\t' read -r n act kind title doc; do
  if [ "$kind" = stage ]; then OWN["stage ${title%% *}"]=$n; else OWN["$title"]=$n; fi
  drill="seed/scripts/act-$act-drill"
  # typed citations: Refs: trailers inside ```sh fences (prose examples are illustrations)
  # and every `gh issue close` anywhere - that command is always a citation. An act's
  # drill script cites its checkpoint's issue.
  [ "$kind" = checkpoint ] && [ -f "$drill" ] &&
    for x in $(grep -oE '^Refs: #[0-9]+|gh issue close [0-9]+' "$drill" | grep -oE '[0-9]+$' | sort -u); do
      [ "$x" = "$n" ] || badref="$badref$drill cites #$x; its checkpoint's work item is #$n"$'\n'
    done
  [ -n "$doc" ] || continue
  for x in $({ awk '/^```sh/ { insh = 1; next } /^```/ { insh = 0; next } insh && !/--grep/' "$doc" | grep -oE '^Refs: #[0-9]+'
               grep -oE 'gh issue close [0-9]+' "$doc"; } | grep -oE '[0-9]+$' | sort -u); do
    [ "$x" = "$n" ] || badref="$badref$doc cites #$x; its own work item is #$n"$'\n'
  done
done < <(tools/seed-backlog --roster)
# prose pairings: the canonical citation forms - "`#N` is stage NN", "`#N` is the Act X
# checkpoint", "stage NN's work item (#N)" - are validated wherever they appear. Prose may
# mention numbers freely, but a *claimed* pairing must use a canonical form and be right.
while IFS=: read -r f ln pair; do
  x=$(printf '%s' "$pair" | grep -oE '#[0-9]+' | head -1 | tr -d '#')
  key=$(printf '%s' "$pair" | grep -oE 'stage [0-9][0-9]|Act [IVX]+ checkpoint')
  want="${OWN[$key]:-}"
  [ "$x" = "$want" ] || badref="$badref$f:$ln claims #$x is $key; the roster says #${want:-nothing}"$'\n'
done < <(git ls-files '*.md' | xargs grep -noE "#[0-9]+\`? is (the )?(stage [0-9][0-9]|Act [IVX]+ checkpoint)|stage [0-9][0-9]'s work item \(#[0-9]+" 2>/dev/null)
if [ -z "$badref" ]; then
  pass "every work-item citation - sh-fence trailers, issue-close lines, prose pairings - agrees with the roster"
else
  fail "work-item numbers that disagree with the roster:"; printf '%s' "$badref" | sed 's/^/        /'
fi

# --- 7. every stage-number reference names a stage the roster has -------------------
# The renumber hazard: "stage 27" is free text, valid-looking in every era, and a
# reshape shifts what it means. Two halves. (a) Links: a stage-file link's text must
# agree with its target - [stage 12](.../stage-12.md), never [stage 12](.../stage-14.md).
# (b) Text: every 2-digit number the extractor above attaches to the word stage(s),
# in any file, must exist in the roster - so a reference to a stage that no longer
# exists fails loudly instead of aging quietly.
badstage=""
stageset=$(tools/seed-backlog --roster | awk -F'\t' '$3 == "stage" { print substr($4, 1, 2) }')
while IFS=: read -r f ln m; do
  tgt=$(printf '%s' "$m" | grep -oE 'stage-[0-9]{2}\.md' | head -1 | grep -oE '[0-9]{2}')
  txt=${m%%]*}; txt=${txt#[}
  tn=$(printf '%s' "$txt" | grep -oE '[0-9]{2}' | head -1)
  [ -z "$tn" ] || [ "$tn" = "$tgt" ] ||
    badstage="$badstage$f:$ln link text says $tn but points at stage-$tgt.md"$'\n'
done < <(git ls-files '*.md' | xargs grep -noE '\[[^]]*\]\([^)]*stage-[0-9]{2}\.md[^)]*\)' 2>/dev/null)
nrefs=0
while IFS=: read -r f ln m; do
  for n in $(printf '%s' "$m" | grep -oE '[0-9]{2}'); do
    nrefs=$((nrefs + 1))
    echo "$stageset" | grep -qx "$n" ||
      badstage="$badstage$f:$ln references stage $n - the roster has no such stage"$'\n'
  done
done < <(git ls-files '*.md' | xargs grep -noE "$STAGEREF" 2>/dev/null)
if [ -z "$badstage" ]; then
  pass "every stage-number reference resolves to a roster stage, links agreeing with their text ($nrefs references)"
else
  fail "stage references that disagree with the roster or their own link target:"
  printf '%s' "$badstage" | sed 's/^/        /'
fi

# --- 8. comments stay on screen ---------------------------------------------------
# GitHub clips a rendered code block at roughly 110 monospace columns; a comment past
# that is invisible (using-the-course §3): trailing comments on over-long lines move
# above their command, long standalone comments wrap. Quoted expected output (# → …
# lines and their deep-indented continuations) is reproduced faithfully and exempt,
# like the commands themselves. Seeded files
# follow the config repo's conventions, not the course text rules, so seed/ is out.
badcomment=$(git ls-files '*.md' | grep -v '^seed/' | while IFS= read -r f; do
  awk -v F="$f" '
    /^```sh/ { insh = 1; next } /^```/ { insh = 0; next }
    insh && length($0) > 110 {
      if ($0 ~ /^[[:space:]]*# →/ || $0 ~ /^[[:space:]]*#[[:space:]]{4,}/) next
      if ($0 ~ /^[[:space:]]*#/ || $0 ~ /[^[:space:]][[:space:]]+# /)
        print F ":" FNR "  (" length($0) " cols)"
    }' "$f"
done)
if [ -z "$badcomment" ]; then
  pass "every sh-fence comment sits inside the ~110-column render budget"
else
  fail "comments past the render budget - move above the command, or wrap (using-the-course §3):"
  printf '%s\n' "$badcomment" | sed 's/^/        /'
fi

# The shape checks below judge verified stages as FAIL and unverified ones as WARN: an
# unverified stage gets its shape at pre-flight, when its expected output can be read
# off a live tree, and until then its debt is listed, not blocking. STATUS.md's table
# says which is which.
verified=$(awk -F'|' '/^\| [0-9][0-9] \| [0-9]{4}-/ { gsub(/ /, "", $2); print "stage-" $2 }' STATUS.md)
shape() {  # $1 = finding lines (file:… first), $2 = PASS text, $3 = FAIL/WARN text
  local hard="" soft="" line f
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    f=${line%%:*}; f=${f%% *}; f=$(basename "$f" .md)
    if printf '%s\n' "$verified" | grep -qx "$f"; then hard="$hard$line"$'\n'; else soft="$soft$line"$'\n'; fi
  done <<< "$1"
  if [ -z "$hard" ] && [ -z "$soft" ]; then pass "$2"; return; fi
  if [ -n "$hard" ]; then fail "$3"; printf '%s' "$hard" | sed 's/^/        /'; fi
  if [ -n "$soft" ]; then
    printf 'WARN  %s (unverified stages, due at their pre-flight):\n' "$3"
    printf '%s' "$soft" | sed 's/^/        /'
  fi
}

# --- 9. a written file is a heredoc in an sh fence --------------------------------
# "Create `path`:" over a bare yaml/rego/json fence is a file the reader builds by hand,
# and pasted into a shell it runs as commands (stage 12, 2026-09-04). Every written file
# is `cat > path <<'EOF'` inside an sh fence, pasted like any other block.
badwrite=$(git ls-files 'act-*/*.md' | while IFS= read -r f; do
  awk -v F="$f" '
    /^(Create|Write|Save|Add|Put|Author) .*`[^`]+\.(ya?ml|rego|json|toml|ini|sh|md|txt|env)`/ { lead = FNR; next }
    lead && /^```[a-z]+$/ && FNR - lead <= 3 {
      if ($0 != "```sh") print F ":" FNR "  " $0 " fence under a written-file lead-in (line " lead ")"
      lead = 0; next }
    /^```/ { lead = 0 }
  ' "$f"
done)
shape "$badwrite" "every written file is a cat > heredoc in an sh fence" \
  "files the reader would have to build by hand - make each a cat > heredoc in an sh fence"

# --- 10. every step is a paste block ------------------------------------------------
# "Repeat step 2's dance with a base change" is a step the reader has to reconstruct;
# every "run this" is a fenced block at that point, adapted (using-the-course §3).
badprose=$(git ls-files 'act-*/*.md' | xargs grep -nEi \
  "repeat step [0-9]|same dance|as in step [0-9]|as you did (in|at) step|the same (way|as) (in |at )?step" 2>/dev/null || true)
shape "$(printf '%s\n' "$badprose" | cut -c1-140)" "no step asks the reader to repeat an earlier one from memory" \
  "steps described by reference to another - write the block out, adapted"

# --- 11. a Stop & measure bullet that names a command has a block under it --------
# A bullet saying "`./scripts/style-gate` green on the whole tree" is a check with no
# way to run it and nothing to compare against; the shape is a checkbox, its sh block,
# and the expected output (stage 09's, since 2026-09-01).
badmeasure=$(git ls-files 'act-*/*.md' | while IFS= read -r f; do
  awk -v F="$f" '
    /^## Stop & measure/ { sec = 1; next }
    sec && /^## / { if (pending != "") print pending; pending = ""; sec = 0 }
    !sec { next }
    /^- / { if (pending != "") print pending; pending = ""
            if ($0 ~ /`(\.\/)?scripts\/[a-z0-9-]+|`(gh|kubectl|flux|git|kustomize|helm|curl|sops|docker|dotnet) /)
              pending = F ":" FNR "  a command named in a bullet with no block to run it"
            next }
    /^```sh/ { pending = "" }
    END { if (pending != "") print pending }
  ' "$f"
done)
shape "$badmeasure" "every Stop & measure bullet that names a command has a block to run it" \
  "Stop & measure bullets to turn into a checkbox, a block and its expected output"

# --- 12. every branch a stage refers to is one the stage creates -----------------
# `gh pr close rendered-diff-demo` for a branch called pin/16/rendered-diff-demo fails
# at the one moment the reader is cleaning up. Only <type>/<issue>/<slug> forms are
# judged; flux-image-updates and main are not branches a stage creates by hand.
badbranch=$(git ls-files 'act-*/*.md' | while IFS= read -r f; do
  created=$(grep -oE '(pr-open|git switch -c|git checkout -b|--push-branch=|--checkout-branch=) ?"?[A-Za-z0-9_/.-]+' "$f" \
    | awk '{ print $NF }' | tr -d '"' | sed -E 's/^--[a-z-]+=//' | sort -u)
  grep -oE '(gh pr (close|view|edit|checks|merge|reopen|ready|diff|comment) |--head "?|git push (-u )?origin )[a-z]+/[0-9]+/[a-z0-9-]+' "$f" \
    | awk '{ print $NF }' | tr -d '"' | sort -u | while IFS= read -r b; do
      printf '%s\n' "$created" | grep -qx "$b" || echo "$f  refers to branch $b, which nothing in the file creates"
    done
done)
shape "$badbranch" "every branch a stage refers to is one it creates" \
  "branches referred to but never created in the same stage"

# --- 13. a merge block does not repeat the watch the previous block ended on ------
baddup=$(git ls-files 'act-*/*.md' | while IFS= read -r f; do
  awk -v F="$f" '
    /^```sh/ { insh = 1; first = 1; last = ""; next }
    /^```/ && insh { insh = 0; lastwatch = (last ~ /^gh pr checks --watch/) ? 1 : 0; next }
    insh && $0 !~ /^[[:space:]]*(#|$)/ {
      if (first && lastwatch && $0 ~ /^gh pr checks --watch/) print F ":" FNR "  repeats the gh pr checks --watch the previous block ended on"
      first = 0; last = $0 }
  ' "$f"
done)
shape "$baddup" "no merge block repeats the watch the block before it ended on" \
  "a block ends with gh pr checks --watch and the next begins with it - keep the one in the merge block"

# --- 14. every rule cited has its number ---------------------------------------------
# The commit-convention appendix numbers its own nine rules; "rule 9" is fine on a line that
# says so (links the appendix or its anchor, or says "commit convention"). Bare, it reads as
# rules.md and misleads.
badrule=$(git ls-files '*.md' | grep -v '^seed/' | grep -v '^appendices/scripts.md$' | xargs grep -nE '\brule [0-9]+([^.0-9]|$)' 2>/dev/null \
  | grep -vE 'commit-convention|commit convention|nine-deciding-rules' || true)
if [ -z "$badrule" ]; then
  pass "every rule is cited as N.N"
else
  fail "rules cited by a bare number - the rules are N.N (stage 11 once said rule 9 for 2.1):"
  printf '%s\n' "$badrule" | cut -c1-140 | sed 's/^/        /'
fi
# --- 15. every seeded script answers --help with its header ---------------------
# The scripts' headers are their documentation, and scripts/help is the menu that reads
# them: a script without a Usage and an Example line, or one that does not answer
# --help, is a hole in the menu the reader meets first.
badhelp=$(for s in seed/scripts/*; do
  [ -x "$s" ] || continue
  out=$(bash "$s" --help 2>&1); rc=$?
  [ "$rc" -eq 0 ] || { echo "$s  --help exits $rc"; continue; }
  grep -q '^Usage:' <<<"$out" || echo "$s  no Usage: line in its header"
  grep -q '^Examples:' <<<"$out" || echo "$s  no Examples: section in its header"
  [ "$(sed -n 2p "$s" | wc -c)" -le 110 ] || echo "$s  summary line (line 2) longer than 110 characters"
done)
if [ -z "$badhelp" ]; then
  pass "every seeded script answers --help with a summary line, a Usage: and an Examples: section"
else
  fail "seeded scripts whose header the menu cannot read:"
  printf '%s\n' "$badhelp" | sed 's/^/        /'
fi

# --- 16. the scripts appendix is the headers, verbatim -------------------------------
# appendices/scripts.md is generated from the seeded scripts' headers; a hand edit there,
# or a header changed without regenerating, is a page that lies about --help.
if tools/gen-scripts-appendix --check >/dev/null 2>&1; then
  pass "appendices/scripts.md matches the seeded scripts' headers"
else
  fail "appendices/scripts.md is stale or hand-edited: run tools/gen-scripts-appendix"
fi


echo
if [ "$fails" -eq 0 ]; then
  echo "OK  the course's cross-references agree with the files on disk"
  exit 0
fi
echo "$fails check(s) failed. Every claim here points at something in another file."
echo "A stage lives in three registers - its file, its README row, and its neighbours'"
echo "nav and Next lines. Move one, move all three."
exit 1
