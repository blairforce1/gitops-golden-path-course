#!/usr/bin/env bash
# The course takes its own medicine (stage 11): the gates every course commit ran by
# hand, run here. Courtesy layer; --no-verify skips it and nothing downstream catches
# that, so do not.
set -uo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0
fail=0
if printf '%s\n' "$staged" | grep -qE '\.md$|^tools/(docs-gate|seed-backlog)$'; then
  out=$(tools/docs-gate 2>&1) || { printf '%s\n' "$out"; fail=1; }
  printf '%s\n' "$out" | grep -E '^WARN' | sed 's/^/pre-commit: /' | head -3
fi
md=$(printf '%s\n' "$staged" | grep -E '\.md$' | grep -v '^seed/' || true)
if [ -n "$md" ]; then
  # shellcheck disable=SC2086
  vale --no-wrap $md || fail=1
fi
if printf '%s\n' "$staged" | grep -qE '\.md$|^seed/scripts/(commit-gate|pr-open|pr-revert)$'; then
  seed/scripts/commit-gate --docs > /tmp/commit-gate.$$ 2>&1 || { cat /tmp/commit-gate.$$; fail=1; }
  rm -f /tmp/commit-gate.$$
fi
seeded=$(printf '%s\n' "$staged" | grep '^seed/' || true)
if [ -n "$seeded" ]; then
  echo "pre-commit: seed/ changed - a sync is owed in the config repo (tools/sync-seed 47):"
  printf '%s\n' "$seeded" | sed 's/^/        /'
fi
exit "$fail"
